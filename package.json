{
  "name": "tocsin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run --project api --project mcp --project cli --project action --project launch",
    "test:contract": "TOCSIN_CONTRACT=1 vitest run --project contract --maxWorkers=1",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit && tsc --noEmit -p workers/mcp && tsc --noEmit -p packages/cli && tsc --noEmit -p action",
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "gen:schema": "node scripts/gen-advisory-validator.mjs",
    "gen:docs": "node scripts/gen-docs.mjs",
    "gen:skills": "node scripts/gen-skills.mjs",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "agents": "^0.30.0",
    "ajv": "^8.20.0",
    "hono": "^4.13.13",
    "semver": "^7.8.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261021.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "@types/semver": "^7.8.0",
    "esbuild": "0.28.2",
    "miniflare": "5.20261019.1-beta",
    "typescript": "^7.0.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.151.3",
    "yaml": "^2.9.1"
  },
  "overrides": {
    "sharp": "^0.35.5",
    "undici": "^7.29.1",
    "zod": "^4.6.7"
  }
}
