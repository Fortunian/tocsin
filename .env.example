# NVD 2.0 API key (raises the NVD rate limit). Real value: wrangler secret put NVD_API_KEY
NVD_API_KEY=
# GitHub token for GitHub advisory reads. Real value: wrangler secret put GITHUB_TOKEN
GITHUB_TOKEN=
# Bearer token of POST /v1/internal/import, the OSV backfill write path. Real value: wrangler secret put IMPORT_TOKEN
# The backfill workflow (.github/workflows/backfill.yml) sends the same value from the Actions secret TOCSIN_IMPORT_TOKEN.
IMPORT_TOKEN=
# MCP worker (workers/mcp): the Tocsin API it reads. Not a secret; set in workers/mcp/wrangler.toml [vars].
TOCSIN_BASE_URL=https://tocsin.sh
# CLI (packages/cli), client side, not worker secrets. Optional API key, sent as a Bearer token.
# TOCSIN_API_KEY=
# CLI: the MCP server URL that `tocsin connect` writes (default https://mcp.tocsin.sh/mcp).
# TOCSIN_MCP_URL=
# MailChannels Email API key: sends the POST /v1/keys confirm links. Unset: key sign-up answers 503.
# Real value: wrangler secret put MAILCHANNELS_API_KEY. The mail-contract workflow reads the Actions secret of the same name.
MAILCHANNELS_API_KEY=
